{
  "app": {
    "name": "unbody-server",
    "env": "${APP_ENV:-production}"
  },
  "swagger": {
    "active": "${SWAGGER_ACTIVE:-0}",
    "path": "/swagger"
  },
  "server": {
    "globalPrefix": "",
    "hostname": "${SERVER_HOSTNAME:-127.0.0.1}",
    "port": "${SERVER_PORT:-3000}"
  },
  "services": {
    "redis": {
      "uri": "${REDIS_URI}"
    },
    "mongodb": {
      "uri": "${MONGODB_URI}"
    },
    "temporal": {
      "address": "${TEMPORAL_ADDRESS}"
    }
  },
  "plugins": {
    "resources": {
      "webhookRegistry": {
        "baseUrl": "${WEBHOOK_BASE_URL}"
      },
      "fileStorage": {
        "rootPath": "${FILE_STORAGE_PATH:-/var/lib/unbody/plugins}"
      }
    }
  }
}